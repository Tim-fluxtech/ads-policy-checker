# All optional. Without any of them the checker, line fixes, full rewrites and
# landing page scans still work.

# AI rewrites (Claude)
ANTHROPIC_API_KEY=
GUARDIAN_MODEL=claude-opus-5-5
# Most AI rewrites the whole site may run per day (protects your Claude bill)
AI_DAILY_CAP=50

# Email every form request to you (free Resend account: resend.com → API Keys)
RESEND_API_KEY=
LEAD_NOTIFY_TO=you@example.com
# Until you verify your own domain in Resend, keep the default sender
# "Guardian <onboarding@resend.dev>"; it can only send to your Resend login email.
LEAD_NOTIFY_FROM=

# Stripe Payment Link for the €49 Recovery Pack (https://buy.stripe.com/...).
# When set, people who send a recovery request see a "Pay €49" button.
RECOVERY_PAY_LINK=

# Set to 1 on Render/Railway/Fly so rate limits use the visitor's IP
TRUST_PROXY=0
PORT=5173
